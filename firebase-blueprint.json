{
  "entities": {
    "TournamentState": {
      "title": "Tournament State",
      "description": "The entire state of the tournament including settings, teams, and matches.",
      "type": "object",
      "properties": {
        "settings": { "type": "object" },
        "teams": { "type": "array" },
        "matches": { "type": "array" },
        "currentMatchId": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["settings", "teams", "matches"]
    }
  },
  "firestore": {
    "/tournaments/singleton": {
      "schema": "TournamentState",
      "description": "The single global tournament state."
    }
  }
}
